{
  "name": "neuralforge-js",
  "version": "0.1.0",
  "description": "Neural network toolkit for JavaScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["neural networks", "machine learning", "ai"],
  "author": "Leandro <your-email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leandro4979-hub/neuralforge-js"
  },
  "bugs": {
    "url": "https://github.com/leandro4979-hub/neuralforge-js/issues"
  },
  "homepage": "https://github.com/leandro4979-hub/neuralforge-js#readme",
  "dependencies": {
    "mathjs": "^11.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.39.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.4"
  }
}
